#!/bin/bash
#PBS -N pixi_gpu_test
#PBS -q gpu_1
#PBS -l select=1:ncpus=9:ngpus=1
#PBS -P CSCI1166
#PBS -l walltime=01:00:00
#PBS -m abe -M u25735056@tuks.co.za

# Navigate to the folder where job is submitted (project folder)
cd $PBS_O_WORKDIR

echo
echo "`date`: executing CUDA job on host ${HOSTNAME}"
echo "Available GPU devices: $CUDA_VISIBLE_DEVICES"
echo

# 1. Load the specific CUDA module required by cluster's physical NVIDIA drivers
module load chpc/cuda/12.0/12.0

echo "Starting Pixi Test..."

# 2. Execute test using the absolute path to Pixi
~/.pixi/bin/pixi run test

echo "Starting Pixi Run..."

# 2. Execute experiment run using the absolute path to Pixi
~/.pixi/bin/pixi run cls_imb
