#!/bin/bash
#PBS -N pixi_gpu_test
#PBS -q gpu_1
#PBS -l select=1:ncpus=9:ngpus=1
#PBS -P CSCI1166
#PBS -l walltime=00:45:00
#PBS -M u25735056@tuks.co.za
#PBS -m abe

# Navigate to the folder where job is submitted (project folder)
cd $PBS_O_WORKDIR

echo
echo "`date`: executing CUDA job on host ${HOSTNAME}"
echo "Available GPU devices: $CUDA_VISIBLE_DEVICES"
echo "JOB STARTED AT: $(date '+%Y-%m-%d %H:%M:%S')"
echo

# 1. Load the specific CUDA module required by cluster's physical NVIDIA drivers
module load chpc/cuda/12.0/12.0

echo "Starting Muon Class Imbalance Large Experiment Run via Pixi..."

# 2. Execute current experiment (cls_imb_s) run using the absolute path to Pixi
~/.pixi/bin/pixi run muon_cls_imb_l --run={{run}} --seed={{seed}} --slice={{slice}} --ratio_seed={{ratio_seed}}
echo "JOB FINISHED AT: $(date '+%Y-%m-%d %H:%M:%S')"